#!/usr/bin/env bash

set -e

case "$1" in

    week1)
        echo
        echo "Running Week 1 tests..."
        echo

        pytest -v tests/test_week1.py

        echo
        echo "✓ All tests passed"
        echo
        echo "Running code quality checks..."
        echo

        flake8 src tests

        echo
        echo "✓ No linting issues found"
        echo "✓ Week 1 complete"
        echo "✓ Ready to commit and push"
        ;;

    week2)
        echo
        echo "Running Week 2 tests..."
        echo

        pytest -v tests/test_week2.py

        echo
        echo "✓ All tests passed"
        echo
        echo "Running code quality checks..."
        echo

        flake8 src tests

        echo
        echo "✓ No linting issues found"
        echo "✓ Week 2 complete"
        echo "✓ Ready to commit and push"
        ;;

    help)
        echo
        echo "Available commands:"
        echo
        echo "  ./run week1"
        echo "      Run Week 1 tests and linting"
        echo
        echo "  ./run week2"
        echo "      Run Week 2 tests and linting"
        echo
        echo "  ./run help"
        echo "      Show this message"
        echo
        ;;

    *)
        echo
        echo "I don't recognise that command."
        echo
        echo "Try:"
        echo
        echo "  ./run help"
        echo
        exit 1
        ;;

esac
